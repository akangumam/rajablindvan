#!/bin/sh
# Pre-commit hook untuk Rajablindvan Vehicle Dashboard
# Copy file ini ke .git/hooks/pre-commit dan chmod +x

echo "🔍 Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for sensitive files
SENSITIVE_FILES=(.env .env.production .env.backup auth.json)
for file in "${SENSITIVE_FILES[@]}"; do
    if git diff --cached --name-only | grep -q "^$file$"; then
        echo "${RED}❌ Error: Attempting to commit sensitive file: $file${NC}"
        echo "Please remove it from staging: git reset HEAD $file"
        exit 1
    fi
done

# Check for debug statements in PHP files
echo "🔎 Checking for debug statements..."
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')
if [ -n "$FILES" ]; then
    for FILE in $FILES; do
        # Check for dd(), dump(), var_dump()
        if grep -qE "(dd\(|dump\(|var_dump\(|print_r\()" "$FILE"; then
            echo "${YELLOW}⚠️  Warning: Debug statement found in $FILE${NC}"
            echo "Please remove debug statements before committing."
            # Uncomment next line to block commit with debug statements
            # exit 1
        fi
        
        # Check for console.log in blade files
        if grep -qE "console\.log\(" "$FILE"; then
            echo "${YELLOW}⚠️  Warning: console.log found in $FILE${NC}"
        fi
    done
fi

# Check for TODO comments
TODO_COUNT=$(git diff --cached | grep -c "TODO" || true)
if [ "$TODO_COUNT" -gt 0 ]; then
    echo "${YELLOW}⚠️  Warning: Found $TODO_COUNT TODO comments in staged changes${NC}"
fi

# Run PHP syntax check
echo "🔧 Running PHP syntax check..."
for FILE in $FILES; do
    php -l "$FILE" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "${RED}❌ PHP syntax error in $FILE${NC}"
        php -l "$FILE"
        exit 1
    fi
done

# Check commit message file exists (for prepare-commit-msg hook)
if [ ! -f .git/COMMIT_EDITMSG ]; then
    echo "${GREEN}✅ Pre-commit checks passed!${NC}"
else
    echo "${GREEN}✅ Pre-commit checks passed!${NC}"
fi

exit 0
