#!/bin/sh
# Post-commit hook untuk Rajablindvan Vehicle Dashboard
# Display commit info after successful commit

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "${GREEN}✅ Commit successful!${NC}"
echo ""
echo "${BLUE}📝 Commit Details:${NC}"
git log -1 --pretty=format:"   Hash: %h%n   Author: %an%n   Date: %ar%n   Message: %s%n"
echo ""
echo ""
echo "${BLUE}📊 Repository Status:${NC}"
echo "   Branch: $(git symbolic-ref --short HEAD)"
echo "   Total commits: $(git rev-list --count HEAD)"
echo ""

# Remind to push if needed
UNPUSHED=$(git log @{u}.. --oneline 2>/dev/null | wc -l)
if [ "$UNPUSHED" -gt 0 ]; then
    echo "${BLUE}💡 You have $UNPUSHED unpushed commit(s). Don't forget to push!${NC}"
    echo "   Run: git push"
    echo ""
fi
