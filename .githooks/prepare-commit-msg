#!/bin/sh
# Prepare-commit-msg hook untuk Rajablindvan Vehicle Dashboard
# Automatically adds branch name to commit message

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# Get current branch name
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

# Only add branch name if it's a feature/fix/hotfix branch
if [ -n "$BRANCH_NAME" ] && echo "$BRANCH_NAME" | grep -qE "^(feature|fix|hotfix|bugfix)/"; then
    # Extract ticket number if exists (e.g., feature/TICKET-123-description)
    TICKET=$(echo "$BRANCH_NAME" | grep -oE "[A-Z]+-[0-9]+" | head -1)
    
    # Read current commit message
    CURRENT_MSG=$(cat "$COMMIT_MSG_FILE")
    
    # Only add if message doesn't already contain branch or ticket info
    if ! echo "$CURRENT_MSG" | grep -qE "($BRANCH_NAME|$TICKET)"; then
        if [ -n "$TICKET" ]; then
            # Add ticket number to commit message
            echo "[$TICKET] $CURRENT_MSG" > "$COMMIT_MSG_FILE"
        else
            # Add branch name as reference
            echo "$CURRENT_MSG" > "$COMMIT_MSG_FILE"
            echo "" >> "$COMMIT_MSG_FILE"
            echo "Branch: $BRANCH_NAME" >> "$COMMIT_MSG_FILE"
        fi
    fi
fi
